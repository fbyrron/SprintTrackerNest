{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "lib": [
      "ES2021"
    ],
    "outDir": "out",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "models/**/*.ts",
    "core/**/*.ts",
    "src/**/*.ts",
    "webview/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "out"
  ]
}
